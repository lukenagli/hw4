# Copy this file to a new file named .env in this same top-level folder,
# then replace the placeholder with your real key. Never commit .env.

# Required: Portkey gateway key (the course key)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional settings (remove the # to use one)
# OPENAI_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# SESSION_SECRET=any-long-random-string
# FACT_CHECK_DEMO=1    # demo only: makes the first draft of a reply carry a wrong price so the fact check fixes it
